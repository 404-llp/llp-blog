---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在">
  <p class="mono">404 · 这里什么都没有</p>
  <h1 class="page-title">这一页<br />还没写。</h1>
  <p class="lede" style="margin-top:1.5rem">
    链接可能过期了，或者标题改了。回到归档页翻翻看。
  </p>
  <div class="btn-row">
    <a class="btn" href="/archive">浏览全部文章</a>
    <a class="btn btn--ghost" href="/">回首页</a>
  </div>
</BaseLayout>
